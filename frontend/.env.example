# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Web application client ID (used for frontend Google sign-in).
# Register http://localhost:5173 in this client's Authorized JavaScript origins.
# Every additional host/port needs its own origin entry; see README.md.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
